<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CalendarWinUI3.Views.MonthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CalendarWinUI3.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:CalendarWinUI3.Models"
    xmlns:converters="using:CalendarWinUI3.Views.Converter" 
    xmlns:system="using:System" xmlns:usercontrols="using:CalendarWinUI3.Views.UserControls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <converters:HolidayForegroundConverter x:Key="HolidayForegroundConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToForegroundConverter x:Key="BoolToForegroundConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:WidthConverter x:Key="WidthConverter"/>
        <converters:HeightConverter x:Key="HeightConverter"/>
        <converters:BoolToAccentColorConverter x:Key="BoolToAccentColorConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:WeekNoToStringConverter x:Key="WeekNoToStringConverter"/>
        <Style x:Key="WeekGridView_ItemContainerStyle"
            TargetType="GridViewItem">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <DataTemplate x:Key="WeekTemplate" x:DataType="models:ChineseDay">
            <Border x:Name="weekBlockBorder" HorizontalAlignment="Stretch">
                <Grid>
                    <TextBlock Text="{x:Bind WeekNo, Converter={StaticResource WeekNoToStringConverter}}" FontSize="14"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="MonthTemplate" x:DataType="models:Day">
            <Border x:Name="dayBlockBorder" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="15"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{x:Bind WeekNo}" FontSize="10" HorizontalAlignment="Center" Visibility="{x:Bind ShowWeekNo, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Border Grid.Row="1" 
                            BorderBrush="{x:Bind IsToday, Converter={StaticResource BoolToAccentColorConverter}}" 
                            BorderThickness="0" 
                            Background="{x:Bind IsToday, Converter={StaticResource BoolToAccentColorConverter}}" 
                            CornerRadius="14" Width="32" Height="32" Margin="5,0">
                        <TextBlock Text="{x:Bind DayNo}" 
                                   Opacity="{x:Bind IsCurrentMonth, Converter={StaticResource BoolToOpacityConverter}}" 
                                   FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Row="2" Text="{x:Bind LunarDay}" FontSize="12"
                               Opacity="{x:Bind IsCurrentMonth, Converter={StaticResource BoolToOpacityConverter}}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    
                    <Ellipse Grid.Row="3" Width="10" Height="10" Fill="Green" 
                             Visibility="{x:Bind IsHoliday, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Ellipse Grid.Row="3" Width="10" Height="10" Fill="Red" 
         Visibility="{x:Bind IsWorkdayOverride, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
       
    </Page.Resources>
    
    <Grid x:Name="rootGrid" Margin="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- 窄窗口 -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GridSplitter.(Grid.Row)" Value="2"/>
                        <Setter Target="GridSplitter.(Grid.Column)" Value="0"/>
                        <Setter Target="GridSplitter.ResizeDirection" Value="Rows"/>
                        <Setter Target="GridSplitter.(Grid.RowSpan)" Value="1"/>
                        <Setter Target="GridSplitter.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="GridSplitter.Height" Value="2"/>
                        <Setter Target="ChineseAlmanacControl.(Grid.Row)" Value="3"/>
                        <Setter Target="ChineseAlmanacControl.(Grid.Column)" Value="0"/>
                        <Setter Target="ChineseAlmanacControl.(Grid.RowSpan)" Value="1"/>
                        <Setter Target="ChineseAlmanacControl.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="ChineseAlmanacControl.Width" Value="Auto"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- 宽窗口 -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GridSplitter.(Grid.Row)" Value="0"/>
                        <Setter Target="GridSplitter.(Grid.Column)" Value="1"/>
                        <Setter Target="GridSplitter.ResizeDirection" Value="Columns"/>
                        <Setter Target="GridSplitter.(Grid.RowSpan)" Value="4"/>
                        <Setter Target="ChineseAlmanacControl.(Grid.Row)" Value="0"/>
                        <Setter Target="ChineseAlmanacControl.(Grid.Column)" Value="2"/>
                        <Setter Target="ChineseAlmanacControl.(Grid.RowSpan)" Value="4"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" MinWidth="400"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GridView x:Name="weekGridView" 
                  ItemTemplate="{StaticResource WeekTemplate}" 
                  ItemContainerStyle="{StaticResource WeekGridView_ItemContainerStyle}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top"
                  SizeChanged="weekGridView_SizeChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="7" 
                           HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <GridView x:Name="monthGridView" Grid.Row="1" 
                  ItemTemplate="{StaticResource MonthTemplate}"
                  VerticalAlignment="Stretch"
                  SizeChanged="monthGridView_SizeChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid
              MaximumRowsOrColumns="7" HorizontalAlignment="Stretch"
                Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <!-- 竖向分隔(宽窗口) -->
        <toolkit:GridSplitter x:Name="GridSplitter" Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
            Width="2" MinHeight="8" Height="Auto"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />

        <!-- 横向分隔(窄窗口)，默认隐藏，由代码在窄模式下启用布局和可见性 -->
        <toolkit:GridSplitter x:Name="HorizontalSplitter" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
            Height="8" MinHeight="8" Width="Auto"
            Background="#01FFFFFF"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows"
            Visibility="Collapsed" />

        <usercontrols:ChineseAlmanac x:Name="ChineseAlmanacControl"
                                     Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" />
       
    </Grid>

</Page>
